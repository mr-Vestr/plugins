def _get_lang():
    try:
        lang = Locale.getDefault().getLanguage()
        return lang if lang in ('ru', 'en') else 'en'
    except Exception:
        return 'en'

def _get_context():
    if ApplicationLoader:
        try:
            return ApplicationLoader.applicationContext
        except Exception:
            pass
    return None


def _adb_lite_first_launch_path():
    ctx = _get_context()
    if not ctx:
        return None
    return os.path.join(str(ctx.getFilesDir()), "adb_lite", "a.txt")

def _is_first_launch():
    path = _adb_lite_first_launch_path()
    if not path:
        return False
    return not (os.path.isdir(os.path.dirname(path)) and os.path.isfile(path))

def _mark_first_launch():
    path = _adb_lite_first_launch_path()
    if not path:
        return
    adb_dir = os.path.dirname(path)
    os.makedirs(adb_dir, exist_ok=True)
    with open(path, "w") as f:
        f.write(str(time.time()))


class ADBLiteServer:
    plugin_instance = None
    
    def __init__(self, host='0.0.0.0', port=MIN_PORT):
        self.host = host
        self.port = port
        self.socket = None
        self.running = False
        self.thread = None
    
    def start(self):
        try:
            self.socket = socket.socket(socket.AF_INET, socket.SOCK_STREAM)
            self.socket.setsockopt(socket.SOL_SOCKET, socket.SO_REUSEADDR, 1)
            self.socket.bind((self.host, self.port))
            self.socket.listen(5)
            self.running = True
            self.thread = threading.Thread(target=self._serve_loop, daemon=True)
            self.thread.start()
            return True
        except Exception as e:
            return False
    
    def stop(self):
        self.running = False
        try:
            if self.socket:
                self.socket.close()
        except Exception:
            pass
        self.socket = None
    
    def _serve_loop(self):
        while self.running:
            try:
                self.socket.settimeout(1.0)
                client, address = self.socket.accept()
                threading.Thread(target=self._handle_client, args=(client, address), daemon=True).start()
            except socket.timeout:
                continue
            except Exception:
                break
    
    def _handle_client(self, client, address):
        try:
            client.settimeout(10.0)
            request = b''
            while b'\r\n\r\n' not in request:
                chunk = client.recv(4096)
                if not chunk:
                    break
                request += chunk
                if len(request) > 65536:
                    break
            
            if not request:
                return
            
            header_end = request.find(b'\r\n\r\n')
            if header_end == -1:
                return
            header_bytes = request[:header_end]
            body = request[header_end+4:]
            
            try:
                header_text = header_bytes.decode('utf-8', errors='ignore')
            except Exception:
                header_text = header_bytes.decode('iso-8859-1', errors='ignore')
            lines = header_text.split('\r\n')
            if not lines:
                return
            
            request_line = lines[0]
            parts = request_line.split()
            if len(parts) < 2:
                return
            
            method = parts[0]
            path = parts[1]
            
            headers = {}
            for line in lines[1:]:
                if ':' in line:
                    key, value = line.split(':', 1)
                    headers[key.strip().lower()] = value.strip()
            
            try:
                content_length = int(headers.get('content-length', '0').strip() or 0)
            except Exception:
                content_length = 0
            
            if content_length > 0 and len(body) < content_length:
                while len(body) < content_length:
                    chunk = client.recv(min(8192, content_length - len(body)))
                    if not chunk:
                        break
                    body += chunk
                if len(body) > content_length:
                    body = body[:content_length]
            elif content_length == 0 and not body:
                client.settimeout(0.5)
                try:
                    while True:
                        chunk = client.recv(8192)
                        if not chunk:
                            break
                        body += chunk
                except socket.timeout:
                    pass
                except Exception:
                    pass
                finally:
                    client.settimeout(10.0)
            
            response = self._process_request(method, path, headers, body, address)
            client.sendall(response.encode('utf-8'))
            
        except Exception as e:
            try:
                error_response = "HTTP/1.1 500 Internal Server Error\r\nContent-Length: 0\r\n\r\n"
                client.sendall(error_response.encode('utf-8'))
            except:
                pass
        finally:
            try:
                client.close()
            except:
                pass
    
    def _process_request(self, method, path, headers, body, address):
        cors_headers = "Access-Control-Allow-Origin: *\r\nAccess-Control-Allow-Methods: GET, POST, OPTIONS\r\nAccess-Control-Allow-Headers: Content-Type, X-Filename, X-Device-Token\r\n"
        try:
            if method == 'OPTIONS':
                return f"HTTP/1.1 200 OK\r\n{cors_headers}Content-Length: 0\r\n\r\n"
            
            if method == 'GET':
                if path == '/test':
                    if ADBLiteServer.plugin_instance:
                        device_info = ADBLiteServer.plugin_instance._get_device_info()
                        response = json.dumps(device_info)
                    else:
                        response = '{}'
                    return f"HTTP/1.1 200 OK\r\n{cors_headers}Content-Type: application/json\r\nContent-Length: {len(response)}\r\n\r\n{response}"
                elif path == '/' or path == '':
                    redirect_url = "https://github.com/mr-Vestr/adb-lite-desktop"
                    response_body = f"<html><head><meta http-equiv=\"refresh\" content=\"0; url={redirect_url}\" /></head><body>Redirecting to <a href=\"{redirect_url}\">ADB Lite Desktop</a>...</body></html>"
                    return f"HTTP/1.1 302 Found\r\n{cors_headers}Location: {redirect_url}\r\nContent-Type: text/html\r\nContent-Length: {len(response_body)}\r\n\r\n{response_body}"
                else:
                    return f"HTTP/1.1 404 Not Found\r\n{cors_headers}Content-Length: 0\r\n\r\n"
            
            if method == 'POST':
                if path == '/connect':
                    return self._handle_connect(body, cors_headers, address)
                elif path == '/install':
                    return self._handle_install(body, headers, cors_headers)
                elif path == '/check':
                    return self._handle_check(body, cors_headers)
                else:
                    return f"HTTP/1.1 404 Not Found\r\n{cors_headers}Content-Length: 0\r\n\r\n"
            
            return f"HTTP/1.1 405 Method Not Allowed\r\n{cors_headers}Content-Length: 0\r\n\r\n"
            
        except Exception as e:
            error_msg = f"no\nerror: {str(e)}"
            return f"HTTP/1.1 200 OK\r\n{cors_headers}Content-Type: text/plain\r\nContent-Length: {len(error_msg)}\r\n\r\n{error_msg}"
    
    def _handle_connect(self, body, cors_headers, address):
        try:
            post_data = body.decode('utf-8', errors='ignore')
            lines = post_data.strip().split('\n')
            
            if len(lines) >= 3 and lines[0] == 'adb_lite_s':
                device_name = lines[1] if len(lines) > 1 else 'Unknown'
                os_name = lines[2] if len(lines) > 2 else 'Unknown'
                token = lines[3].strip() if len(lines) > 3 else ''
                pc_address = lines[4].strip() if len(lines) > 4 else ''
                desktop_support = lines[5].strip() if len(lines) > 5 else ''
                if not pc_address and address:
                    pc_address = address[0]
                
                if ADBLiteServer.plugin_instance:
                    result = ADBLiteServer.plugin_instance._handle_connection_request(
                        device_name, os_name, address, token, pc_address, desktop_support
                    )
                    if result.startswith('yes') and token:
                        ADBLiteServer.plugin_instance._device_last_check[token] = (device_name, time.time())
                    return f"HTTP/1.1 200 OK\r\n{cors_headers}Content-Type: text/plain\r\nContent-Length: {len(result)}\r\n\r\n{result}"
                else:
                    return f"HTTP/1.1 500 Internal Server Error\r\n{cors_headers}Content-Length: 0\r\n\r\n"
            else:
                return f"HTTP/1.1 400 Bad Request\r\n{cors_headers}Content-Length: 0\r\n\r\n"
        except Exception as e:
            return f"HTTP/1.1 500 Internal Server Error\r\n{cors_headers}Content-Length: 0\r\n\r\n"
    
    def _handle_check(self, body, cors_headers):
        try:
            post_data = body.decode('utf-8', errors='ignore')
            lines = post_data.strip().split('\n')
            
            token = lines[0].strip() if len(lines) > 0 else ''
            device_name = lines[1].strip() if len(lines) > 1 else ''
            
            if ADBLiteServer.plugin_instance:
                idx, device = ADBLiteServer.plugin_instance._find_device_by_token(token)
                if idx >= 0 and not device.get('blocked', False):
                    result = 'yes'
                    ADBLiteServer.plugin_instance._device_last_check[token] = (device_name, time.time())
                else:
                    result = 'no'
            else:
                result = 'no'
            
            return f"HTTP/1.1 200 OK\r\n{cors_headers}Content-Type: text/plain\r\nContent-Length: {len(result)}\r\n\r\n{result}"
        except Exception as e:
            return f"HTTP/1.1 200 OK\r\n{cors_headers}Content-Type: text/plain\r\nContent-Length: 2\r\n\r\nno"
    
    def _handle_install(self, body, headers, cors_headers):
        try:
            filename = headers.get('x-filename', 'unknown.plugin')
            token = headers.get('x-device-token', '').strip()
            
            if not body:
                return f"HTTP/1.1 400 Bad Request\r\n{cors_headers}Content-Length: 0\r\n\r\n"
            
            if ADBLiteServer.plugin_instance:
                result = ADBLiteServer.plugin_instance._handle_install_request(filename, body, token)
                if result.startswith('yes') and token:
                    idx, dev = ADBLiteServer.plugin_instance._find_device_by_token(token)
                    if idx >= 0:
                        dname = ADBLiteServer.plugin_instance._get_device_display_name(dev)
                        ADBLiteServer.plugin_instance._device_last_check[token] = (dname, time.time())
                return f"HTTP/1.1 200 OK\r\n{cors_headers}Content-Type: text/plain\r\nContent-Length: {len(result)}\r\n\r\n{result}"
            else:
                return f"HTTP/1.1 500 Internal Server Error\r\n{cors_headers}Content-Length: 0\r\n\r\n"
        except Exception as e:
            error_msg = f"no\nerror: {str(e)}"
            return f"HTTP/1.1 200 OK\r\n{cors_headers}Content-Type: text/plain\r\nContent-Length: {len(error_msg)}\r\n\r\n{error_msg}"


class _MethodHook:
    def before_hooked_method(self, param):
        pass
    def after_hooked_method(self, param):
        pass

class _BadgeHook(_MethodHook):
    def __init__(self, manager):
        self.manager = manager

    def before_hooked_method(self, param):
        try:
            entity_id = param.args[0] if param.args else None
            if entity_id and entity_id in self.manager.custom_badges:
                param.setResult(self.manager.custom_badges[entity_id])
        except Exception:
            pass

class _DeveloperHook(_MethodHook):
    def __init__(self, manager):
        self.manager = manager

    def before_hooked_method(self, param):
        try:
            entity_id = param.args[0] if param.args else None
            if entity_id and entity_id in self.manager.custom_badges:
                param.setResult(True)
        except Exception:
            pass

class _ChangeHook(_MethodHook):
    def __init__(self, manager):
        self.manager = manager

    def before_hooked_method(self, param):
        try:
            entity_id = param.args[0] if param.args else None
            if entity_id and entity_id in self.manager.custom_badges:
                param.setResult(True)
        except Exception:
            pass


class BadgeManager:
    def __init__(self, plugin):
        self.plugin = plugin
        self.custom_badges = {}
        self._hook_refs = []
        self.api_badge_source = None
        self.lang = _get_lang()

    def setup(self, badges_data):
        try:
            self._get_api_badge_source()
            self._setup_hooks()
            self._load_badges(badges_data)
        except Exception:
            pass

    def _get_api_badge_source(self):
        try:
            BadgesController = find_class("com.exteragram.messenger.badges.BadgesController")
            if not BadgesController:
                return
            instance = BadgesController.INSTANCE
            self.api_badge_source = get_private_field(instance, "apiBadgeSource")
        except Exception:
            pass

    def _setup_hooks(self):
        try:
            if not self.api_badge_source:
                return
            ApiBadgeSource = find_class("com.exteragram.messenger.badges.source.ApiBadgeSource")
            if not ApiBadgeSource:
                return

            for method_name, hook_cls in [
                ("getBadge", _BadgeHook),
                ("isDeveloper", _DeveloperHook),
                ("canChangeBadge", _ChangeHook),
            ]:
                refs = self.plugin.hook_all_methods(ApiBadgeSource, method_name, hook_cls(self))
                if refs:
                    self._hook_refs.extend(refs)
        except Exception:
            pass

    def _load_badges(self, badges_data):
        try:
            if not self.api_badge_source or not badges_data:
                return
            cache = get_private_field(self.api_badge_source, "cache")
            if not cache:
                return
            BadgeDTO = find_class("com.exteragram.messenger.api.dto.BadgeDTO")
            BadgeInfo = find_class("com.exteragram.messenger.badges.source.BadgeInfo")
            ProfileStatus = find_class("com.exteragram.messenger.api.model.ProfileStatus")
            if not all([BadgeDTO, BadgeInfo, ProfileStatus]):
                return
            for entry in badges_data:
                emoji_id = entry.get("emoji_id")
                text_key = f"text_{self.lang}"
                text = entry.get(text_key) or entry.get("text_en", "")
                user_id = entry.get("user_id")
                chat_id = entry.get("chat_id")
                if not emoji_id or not text:
                    continue

                if user_id:
                    try:
                        user = MessagesController.getInstance(0).getUser(user_id)
                        name = f"{user.first_name} {user.last_name or ''}".strip() if user else f"User {user_id}"
                    except Exception:
                        name = f"User {user_id}"
                    formatted = text.format(user_name=name)
                    dto  = BadgeDTO(emoji_id, formatted)
                    info = BadgeInfo(dto, ProfileStatus.DEVELOPER, True)
                    cache.put(Long.valueOf(user_id), info)
                    self.custom_badges[user_id] = dto

                elif chat_id:
                    try:
                        chat = MessagesController.getInstance(0).getChat(-abs(chat_id))
                        name = chat.title if chat else f"Channel {chat_id}"
                    except Exception:
                        name = f"Channel {chat_id}"
                    formatted = text.format(chat_name=name)
                    dto  = BadgeDTO(emoji_id, formatted)
                    info = BadgeInfo(dto, ProfileStatus.DEVELOPER, True)
                    cache.put(Long.valueOf(chat_id), info)
                    self.custom_badges[chat_id] = dto

        except Exception:
            pass

    def cleanup(self):
        try:
            for ref in self._hook_refs:
                try:
                    self.plugin.unhook_method(ref)
                except Exception:
                    pass
            self._hook_refs.clear()
            if self.api_badge_source and self.custom_badges:
                try:
                    cache = get_private_field(self.api_badge_source, "cache")
                    if cache:
                        for eid in list(self.custom_badges.keys()):
                            cache.remove(Long.valueOf(eid))
                except Exception:
                    pass
            self.custom_badges.clear()
        except Exception:
            pass


class _DeeplinkHook(MethodHook):
    def __init__(self, plugin):
        self.plugin = plugin

    def before_hooked_method(self, param):
        try:
            if len(param.args) < 7:
                return
            intent = param.args[0]
            if not intent or intent.getAction() != "android.intent.action.VIEW":
                return
            data = intent.getData()
            if not data:
                return
            url = str(data)
            matched_target = self.plugin._match_deeplink(url)
            if matched_target is None:
                return
            param.setResult(None)
            run_on_ui_thread(lambda: self.plugin._handle_target(matched_target))
        except Exception:
            pass


def _open_url_in_telegram(url):
    try:
        fragment = get_last_fragment()
        act = fragment.getParentActivity() if fragment else None
        if act and Browser and Uri:
            Browser.openUrl(act, Uri.parse(url), True, True, True, None, None, False, False, False)
    except Exception:
        pass

def _open_gift_sheet(user_id_str):
    try:
        uid = int(user_id_str)
        if LaunchActivity is None:
            return
        launch_activity = LaunchActivity.instance
        if launch_activity is None:
            return
        get_last = launch_activity.getClass().getDeclaredMethod("getSafeLastFragment")
        get_last.setAccessible(True)
        last_fragment = get_last.invoke(launch_activity)
        if last_fragment is None or last_fragment.getContext() is None:
            return
        current_account = UserConfig.selectedAccount if UserConfig else 0
        sheet = GiftSheet(last_fragment.getContext(), current_account, uid, None, None)
        sheet.show()
    except Exception:
        pass


class ADBLitePlugin(BasePlugin):
    def __init__(self):
        super().__init__()
        self._badge_manager = None
        self._deeplinks = {}
        self._deeplink_hook_ref = None
        self._server = None
        self._server_thread = None
        self._server_port = None
        self._server_running = False
        self._pending_connections = {}
        self._connection_results = {}
        self._saved_devices = self._load_saved_devices_from_storage()
        self._expanded_devices = self._load_expanded_devices_from_storage()
        self._nsd_manager = None
        self._nsd_listener = None
        self._nsd_registered_name = None
        self._device_key = self._get_or_create_device_key()
        self._device_last_check = {}
        self._notified_disconnect = set()
        self._monitor_running = False
        ADBLiteServer.plugin_instance = self
        self.update_available = False
        self.checking_update = False
        self.latest_version = None
        self.changelog = None
        self.download_url = None
        self.sticker_pack = None
        self.sticker_index = None
        try:
            lang_code = LocaleController.getInstance().getCurrentLocale().getLanguage()
            self.lang = 'ru' if lang_code.lower().startswith('ru') else 'en'
        except Exception:
            self.lang = 'en'

    def _lang(self):
        try:
            idx = int(self.get_setting('plugin_lang', 0) or 0)
            forced = ['system', 'ru', 'en'][max(0, min(idx, 2))]
            if forced != 'system':
                return forced
        except Exception:
            pass
        try:
            code = LocaleController.getInstance().getCurrentLocale().getLanguage().lower()
            return 'ru' if code.startswith('ru') else 'en'
        except Exception:
            return 'en'

    def _t(self, key, **kwargs):
        lang = self._lang()
        try:
            return LANG[lang][key].format(**kwargs)
        except Exception:
            try:
                return LANG['ru'][key].format(**kwargs)
            except Exception:
                return key

    def _on_language_changed(self, idx):
        try:
            self.set_setting('plugin_lang', max(0, min(int(idx), 2)))
            run_on_ui_thread(lambda: self.reload_settings())
        except Exception:
            pass

    def _kill_process(self):
        time.sleep(0.3)
        os.kill(os.getpid(), signal.SIGKILL)

    def _show_restart_bulletin(self):
        try:
            BulletinHelper.show_with_button(
                self._t('restart_required'),
                getattr(R_tg.raw, 'chats_infotip', 0),
                self._t('restart_button'),
                lambda: threading.Thread(target=self._kill_process, daemon=True).start(),
                None
            )
        except Exception:
            pass

    def open_plugin_settings(self):
        def _open_settings():
            try:
                fragment = get_last_fragment()
                plugin = PluginsController.getInstance().plugins.get(self.id)
                if plugin:
                    settings_activity = PluginSettingsActivity(plugin)
                    fragment.presentFragment(settings_activity)
            except Exception as e:
                pass
        run_on_ui_thread(_open_settings)

    def _update_drawer_menu(self):
        show_drawer = self.get_setting('show_drawer_menu', False)
        self.remove_menu_item('adb_lite_drawer')
        if show_drawer:
            self.add_menu_item(MenuItemData(
                menu_type=MenuItemType.DRAWER_MENU,
                text='ADB Lite',
                icon='msg_language',
                item_id='adb_lite_drawer',
                on_click=lambda ctx: self.open_plugin_settings()
            ))

    def _setup_settings_activity_hook(self):
        try:
            SA = find_class("org.telegram.ui.SettingsActivity")
            if SA is None:
                return
            ArrayList = find_class("java.util.ArrayList")
            UniversalAdapter = find_class("org.telegram.ui.Components.UniversalAdapter")
            if ArrayList is None or UniversalAdapter is None:
                return
            _SETTINGS_BTN_ID = 880092
            plugin_ref = self

            class FillItemsHook(MethodHook):
                def after_hooked_method(self, param):
                    try:
                        if not plugin_ref.get_setting('show_settings_menu_button', True):
                            return
                        items = param.args[0]
                        if items is None or items.size() == 0:
                            return
                        for i in range(items.size()):
                            item = items.get(i)
                            try:
                                if item is not None and int(item.id) == _SETTINGS_BTN_ID:
                                    return
                            except Exception:
                                pass
                        extera_idx = -1
                        for i in range(items.size()):
                            item = items.get(i)
                            try:
                                if item is not None and int(item.id) == -1:
                                    extera_idx = i
                                    break
                            except Exception:
                                pass
                        if extera_idx < 0:
                            return
                        SettingCellFactory = find_class("org.telegram.ui.SettingsActivity$SettingCell$Factory")
                        if SettingCellFactory is None:
                            return
                        icon_id = 0
                        try:
                            icon_id = int(getattr(R_tg.drawable, 'settings_language', getattr(R_tg.drawable, 'msg_filled_data_files', 0)))
                        except Exception:
                            pass
                        label = plugin_ref._t('adb_lite_settings')
                        of_method = None
                        for m in SettingCellFactory.getClass().getDeclaredMethods():
                            try:
                                if m.getName() == "of" and len(m.getParameterTypes()) == 5:
                                    of_method = m
                                    break
                            except Exception:
                                pass
                        if of_method is None:
                            return
                        of_method.setAccessible(True)
                        _PURPLE = -5963271
                        item = of_method.invoke(None, [jint(_SETTINGS_BTN_ID), jint(_PURPLE), jint(_PURPLE), jint(icon_id), label])
                        if item is None:
                            return
                        try:
                            item_cls = item.getClass()
                            for _fname in ('iconColor', 'iconBgColor', 'color', 'bgColor'):
                                try:
                                    _f = item_cls.getDeclaredField(_fname)
                                    _f.setAccessible(True)
                                    _f.setInt(item, _PURPLE)
                                    break
                                except Exception:
                                    pass
                        except Exception:
                            pass
                        items.add(extera_idx + 1, item)
                    except Exception as e:
                        pass

            class OnClickHook(MethodHook):
                def before_hooked_method(self, param):
                    try:
                        uItem = param.args[0]
                        if uItem is None:
                            return
                        if int(uItem.id) != _SETTINGS_BTN_ID:
                            return
                        param.setResult(None)
                        def open():
                            try:
                                frag = get_last_fragment()
                                plugin_obj = PluginsController.getInstance().plugins.get(plugin_ref.id)
                                if plugin_obj and frag:
                                    frag.presentFragment(PluginSettingsActivity(plugin_obj))
                            except Exception as e:
                                pass
                        run_on_ui_thread(open)
                    except Exception as e:
                        pass
            try:
                fill_method = SA.getClass().getDeclaredMethod("fillItems", ArrayList, UniversalAdapter)
                fill_method.setAccessible(True)
                self.hook_method(fill_method, FillItemsHook())
            except Exception as e:
                pass
            try:
                click_method = None
                for m in SA.getClass().getDeclaredMethods():
                    try:
                        if m.getName() == "onClick" and len(m.getParameterTypes()) == 5:
                            click_method = m
                            break
                    except Exception:
                        pass
                if click_method:
                    click_method.setAccessible(True)
                    self.hook_method(click_method, OnClickHook())
            except Exception as e:
                pass
        except Exception as e:
            pass

    def _format_timestamp(self, timestamp):
        try:
            dt = datetime.fromtimestamp(timestamp)
            return dt.strftime('%d.%m.%Y %H:%M')
        except Exception:
            return str(timestamp)

    def _get_devices_prefs(self):
        try:
            ctx = _get_context()
            if ctx:
                return ctx.getSharedPreferences(DEVICES_PREFS, 0)
        except Exception:
            pass
        return None

    def _normalize_device(self, d):
        if not isinstance(d, dict):
            return None
        if 'real_name' in d and 'custom_name' in d:
            return {
                'serial': int(d.get('serial', 0)),
                'real_name': str(d.get('real_name', 'Unknown')),
                'custom_name': str(d.get('custom_name', d.get('real_name', 'Unknown'))),
                'url': str(d.get('url', 'Unknown')),
                'token': str(d.get('token', '')),
                'first_connection': float(d.get('first_connection', 0)),
                'last_connection': float(d.get('last_connection', 0)),
                'os': str(d.get('os', 'Unknown')),
                'blocked': bool(d.get('blocked', False)),
            }
        real_name = str(d.get('name', d.get('username', 'Unknown')))
        url = str(d.get('url', 'Unknown'))
        if ':' in url:
            url = url.rsplit(':', 1)[0]
        return {
            'serial': int(d.get('serial', 0)),
            'real_name': real_name,
            'custom_name': str(d.get('custom_name', real_name)),
            'url': url,
            'token': str(d.get('token', '')),
            'first_connection': float(d.get('first_connection', 0)),
            'last_connection': float(d.get('last_connection', 0)),
            'os': str(d.get('os', 'Unknown')),
            'blocked': bool(d.get('blocked', False)),
        }

    def _load_saved_devices_from_storage(self):
        try:
            prefs = self._get_devices_prefs()
            if prefs:
                raw = prefs.getString(DEVICES_KEY, None)
                if raw:
                    data = json.loads(raw)
                    if isinstance(data, list):
                        devices = []
                        for item in data:
                            normalized = self._normalize_device(item)
                            if normalized:
                                devices.append(normalized)
                        return devices
            legacy = self.get_setting('saved_devices', None)
            if legacy and isinstance(legacy, list):
                devices = []
                for item in legacy:
                    normalized = self._normalize_device(item)
                    if normalized:
                        devices.append(normalized)
                if devices:
                    self._saved_devices = devices
                    self._persist_saved_devices()
                return devices
        except Exception:
            pass
        return []

    def _load_expanded_devices_from_storage(self):
        try:
            prefs = self._get_devices_prefs()
            if prefs:
                raw = prefs.getString(EXPANDED_KEY, None)
                if raw:
                    data = json.loads(raw)
                    if isinstance(data, dict):
                        return data
            legacy = self.get_setting('expanded_devices', {})
            if isinstance(legacy, dict):
                return legacy
        except Exception:
            pass
        return {}

    def _persist_saved_devices(self):
        try:
            prefs = self._get_devices_prefs()
            if prefs:
                editor = prefs.edit()
                editor.putString(DEVICES_KEY, json.dumps(self._saved_devices))
                editor.apply()
        except Exception:
            pass

    def _persist_expanded_devices(self):
        try:
            prefs = self._get_devices_prefs()
            if prefs:
                editor = prefs.edit()
                editor.putString(EXPANDED_KEY, json.dumps(self._expanded_devices))
                editor.apply()
        except Exception:
            pass

    def _get_device_display_name(self, device):
        if not device:
            return 'Unknown'
        custom = str(device.get('custom_name', '')).strip()
        if custom:
            return custom
        return str(device.get('real_name', 'Unknown'))

    def _get_currently_connected(self):
        try:
            now = time.time()
            connected = []
            for token, (name, t) in list(self._device_last_check.items()):
                if now - t > 40:
                    continue
                idx, device = self._find_device_by_token(token)
                if idx >= 0:
                    display_name = self._get_device_display_name(device)
                    os_name = device.get('os', 'Unknown')
                    url = device.get('url', 'Unknown')
                    connected.append({
                        'display_name': display_name,
                        'os': os_name,
                        'address': url,
                        'token': token,
                    })
            return connected
        except Exception:
            return []

    def _find_device_by_token(self, token):
        if not token:
            return -1, None
        for i, device in enumerate(self._saved_devices):
            if device.get('token') == token:
                return i, device
        return -1, None

    def _get_os_icon(self, os_name):
        return 'menu_devices'

    def _toggle_device_details(self, device_index):
        try:
            if 0 <= device_index < len(self._saved_devices):
                token = self._saved_devices[device_index].get('token') or str(device_index)
                self._expanded_devices[token] = not self._expanded_devices.get(token, False)
                self._persist_expanded_devices()
                self.set_setting('expanded_devices', self._expanded_devices, reload_settings=True)
        except Exception:
            pass

    def _delete_device(self, device_index):
        try:
            if 0 <= device_index < len(self._saved_devices):
                device = self._saved_devices[device_index]
                device_name = self._get_device_display_name(device)
                
                def show_dialog():
                    try:
                        frag = get_last_fragment()
                        act = frag.getParentActivity() if frag else None
                        if not act:
                            return
                        
                        builder = AlertDialogBuilder(act)
                        builder.set_title(self._t('delete_device_title'))
                        builder.set_message(self._t('delete_device_confirm', name=device_name))
                        
                        def on_confirm(d, w):
                            try:
                                token = device.get('token')
                                del self._saved_devices[device_index]
                                if token and token in self._expanded_devices:
                                    del self._expanded_devices[token]
                                if token and token in self._device_last_check:
                                    del self._device_last_check[token]
                                self._persist_saved_devices()
                                self._persist_expanded_devices()
                                self.set_setting('expanded_devices', self._expanded_devices, reload_settings=True)
                                d.dismiss()
                                BulletinHelper.show_success(self._t('device_deleted', name=device_name))
                            except Exception:
                                pass
                        
                        builder.set_positive_button(self._t('delete'), on_confirm)
                        builder.set_negative_button(self._t('close'), lambda d, w: d.dismiss())
                        try:
                            builder.make_button_red(AlertDialogBuilder.BUTTON_POSITIVE)
                        except Exception:
                            pass
                        builder.show()
                    except Exception:
                        pass
                
                run_on_ui_thread(show_dialog)
        except Exception:
            pass

    def _on_connected_device_click(self, token):
        self._show_disconnect_device_dialog(token)

    def _show_disconnect_device_dialog(self, token):
        try:
            if not token:
                return
            idx, device = self._find_device_by_token(token)
            if idx < 0:
                return
            device_name = self._get_device_display_name(device)

            def show_dialog():
                try:
                    frag = get_last_fragment()
                    act = frag.getParentActivity() if frag else None
                    if not act:
                        return

                    builder = AlertDialogBuilder(act)
                    builder.set_title(self._t('disconnect_device_title'))
                    builder.set_message(self._t('disconnect_device_confirm', name=device_name))

                    def on_confirm(d, w):
                        try:
                            device['blocked'] = True
                            self._persist_saved_devices()
                            if token in self._device_last_check:
                                del self._device_last_check[token]
                            d.dismiss()
                            BulletinHelper.show_success(self._t('device_blocked', name=device_name))
                            self.set_setting('_disconnect_refresh', int(time.time()), reload_settings=True)
                        except Exception:
                            pass

                    builder.set_positive_button(self._t('confirm_disconnect'), on_confirm)
                    builder.set_negative_button(self._t('close'), lambda d, w: d.dismiss())
                    try:
                        builder.make_button_red(AlertDialogBuilder.BUTTON_POSITIVE)
                    except Exception:
                        pass
                    builder.show()
                except Exception:
                    pass

            run_on_ui_thread(show_dialog)
        except Exception:
            pass

    def _toggle_block_device(self, device_index):
        try:
            if 0 <= device_index < len(self._saved_devices):
                device = self._saved_devices[device_index]
                is_blocked = device.get('blocked', False)
                device['blocked'] = not is_blocked
                self._persist_saved_devices()
                device_name = self._get_device_display_name(device)
                if not is_blocked:
                    token = device.get('token')
                    if token and token in self._device_last_check:
                        del self._device_last_check[token]
                    BulletinHelper.show_success(self._t('device_blocked', name=device_name))
                else:
                    BulletinHelper.show_success(self._t('device_unblocked', name=device_name))
                self.set_setting('_block_toggle', int(time.time()), reload_settings=True)
        except Exception:
            pass

    def _show_device_info(self, ctx, device):
        try:
            frag = get_last_fragment()
            act = frag.getParentActivity() if frag else None
            if not act:
                return
            display_name = self._get_device_display_name(device)
            first_conn = device.get('first_connection', 0)
            last_conn = device.get('last_connection', 0)
            first_str = self._format_timestamp(first_conn) if first_conn else '—'
            last_str = self._format_timestamp(last_conn) if last_conn else '—'
            token = device.get('token', '—')
            msg = (f"• {self._t('first_connection')}:\n– {first_str}\n\n"
                   f"• {self._t('last_connection')}:\n– {last_str}\n\n"
                   f"• {self._t('secret_key')}:\n– {token}")
            builder = AlertDialogBuilder(act)
            builder.set_title(display_name)
            builder.set_message(msg)
            builder.set_positive_button(self._t('close'), lambda d, w: d.dismiss())
            builder.show()
        except Exception:
            pass

    def _on_device_name_change(self, device_index, new_name):
        try:
            if 0 <= device_index < len(self._saved_devices):
                self._saved_devices[device_index]['custom_name'] = new_name
                self._persist_saved_devices()
        except Exception:
            pass

    def try_load_sticker(self, img, sticker_name, sticker_index=0, size="72_72"):
        try:
            if isinstance(sticker_name, str) and "/" in sticker_name:
                icon_parts = sticker_name.split("/")
                if len(icon_parts) == 2:
                    sticker_set_name = icon_parts[0]
                    sticker_index = int(icon_parts[1])
            else:
                sticker_set_name = sticker_name
            ss = (MediaDataController.getInstance(0).getStickerSetByName(sticker_set_name)
                  or MediaDataController.getInstance(0).getStickerSetByEmojiOrName(sticker_set_name))
            if ss and ss.documents and ss.documents.size() > sticker_index:
                img.setImage(ImageLocation.getForDocument(ss.documents.get(sticker_index)), size, None, None, 0, 1)
                return True
        except Exception:
            pass
        return False

    def load_sticker_with_fallback(self, img, sticker_name, sticker_index=0, size="72_72", delay=1500):
        try:
            img.setAlpha(0.0)
            img.setScaleX(0.8)
            img.setScaleY(0.8)
        except Exception:
            pass

        if self.try_load_sticker(img, sticker_name, sticker_index, size):
            try:
                img.animate().alpha(1.0).scaleX(1.0).scaleY(1.0).setDuration(300).start()
            except Exception:
                try:
                    img.setAlpha(1.0); img.setScaleX(1.0); img.setScaleY(1.0)
                except Exception:
                    pass
        else:
            try:
                sname = sticker_name.split("/")[0] if isinstance(sticker_name, str) and "/" in sticker_name else sticker_name
                MediaDataController.getInstance(0).loadStickersByEmojiOrName(sname, False, False)
                def load_with_animation():
                    if self.try_load_sticker(img, sticker_name, sticker_index, size):
                        try:
                            img.animate().alpha(1.0).scaleX(1.0).scaleY(1.0).setDuration(300).start()
                        except Exception:
                            try:
                                img.setAlpha(1.0); img.setScaleX(1.0); img.setScaleY(1.0)
                            except Exception:
                                pass
                run_on_ui_thread(load_with_animation, delay)
            except Exception:
                pass

    def _get_device_info(self):
        try:
            context = ApplicationLoader.applicationContext
            package_name = context.getPackageName() if context else None
            
            if package_name == 'com.radolyn.ayugram':
                app_name = 'AyuGram'
            elif package_name == 'com.exteragram.messenger':
                app_name = 'exteraGram'
            else:
                app_name = package_name if package_name else '[Unknown]'

            custom_device_name = self.get_setting('default_device_name', '')
            device_name = custom_device_name if custom_device_name else Build.MODEL
            
            return {
                'device': device_name,
                'manufacturer': Build.MANUFACTURER,
                'android_version': Build.VERSION.RELEASE,
                'app': app_name
            }
        except Exception:
            return {'app': 'Unknown'}
    
    def _get_or_create_device_key(self):
        try:
            key = self.get_setting('device_key', '')
            if not key or len(key) != 30:
                chars = string.ascii_letters + string.digits
                key = ''.join(random.choices(chars, k=30))
                self.set_setting('device_key', key, reload_settings=False)
            return key
        except Exception:
            chars = string.ascii_letters + string.digits
            return ''.join(random.choices(chars, k=30))
    
    def _get_local_ip(self):
        try:
            s = socket.socket(socket.AF_INET, socket.SOCK_DGRAM)
            s.settimeout(0)
            try:
                s.connect(('10.255.255.255', 1))
                ip = s.getsockname()[0]
            except Exception:
                try:
                    hostname = socket.gethostname()
                    ip = socket.gethostbyname(hostname)
                    if ip.startswith('127.') or ip == 'localhost':
                        ip = '127.0.0.1'
                except Exception:
                    ip = '127.0.0.1'
            finally:
                s.close()
            return ip
        except Exception:
            return '127.0.0.1'
    
    def _is_port_available(self, port):
        try:
            s = socket.socket(socket.AF_INET, socket.SOCK_STREAM)
            s.settimeout(1)
            result = s.connect_ex(('0.0.0.0', port))
            s.close()
            return result != 0
        except Exception:
            return False
    
    def _start_server_internal(self):
        port_range = self.get_setting('port_range', f'{MIN_PORT}-{MAX_PORT}')
        try:
            min_port, max_port = map(int, port_range.split('-'))
        except Exception:
            min_port, max_port = MIN_PORT, MAX_PORT
        
        last_port = self.get_setting('last_used_port', None)
        if last_port and min_port <= last_port <= max_port:
            if self._is_port_available(last_port):
                try:
                    self._server = ADBLiteServer('0.0.0.0', last_port)
                    if self._server.start():
                        self._server_port = last_port
                        self._server_running = True
                        self._start_disconnect_monitor()
                        return
                    else:
                        self._server = None
                except Exception:
                    if self._server:
                        self._server.stop()
                        self._server = None
        
        for port in range(min_port, max_port + 1):
            if self._is_port_available(port):
                try:
                    self._server = ADBLiteServer('0.0.0.0', port)
                    if self._server.start():
                        self._server_port = port
                        self._server_running = True
                        self.set_setting('last_used_port', port, reload_settings=False)
                        self._start_disconnect_monitor()
                        return
                    else:
                        self._server = None
                except Exception:
                    if self._server:
                        self._server.stop()
                        self._server = None
                    continue
        self._server_running = False
    
    def _stop_server_internal(self):
        self._monitor_running = False
        try:
            if self._server:
                self._server.stop()
        except Exception:
            pass
        self._server = None
        self._server_port = None
        self._server_running = False
        self._device_last_check.clear()
        self._notified_disconnect.clear()

    def _start_disconnect_monitor(self):
        self._monitor_running = True
        def monitor():
            while self._monitor_running:
                try:
                    now = time.time()
                    stale = []
                    for token, (name, t) in list(self._device_last_check.items()):
                        if now - t > 40:
                            stale.append((token, name))
                    for token, name in stale:
                        del self._device_last_check[token]
                        if self.get_setting('notification_disconnect', False):
                            if token in self._notified_disconnect:
                                continue
                            self._notified_disconnect.add(token)
                            try:
                                BulletinHelper.show_success(self._t('notification_disconnect_text', name=name))
                            except Exception:
                                pass
                except Exception:
                    pass
                time.sleep(15)
        threading.Thread(target=monitor, daemon=True).start()

    def start_server(self):
        if self._server_running:
            return True
        
        def run_server():
            self._start_server_internal()
        
        self._server_thread = threading.Thread(target=run_server, daemon=True)
        self._server_thread.start()
        
        timeout = 5
        start_time = time.time()
        while time.time() - start_time < timeout:
            if self._server_running and self._server_port:
                return True
            time.sleep(0.1)
        
        return False
    
    def stop_server(self):
        self._stop_server_internal()
        if self._server_thread:
            self._server_thread = None
    
    def _show_error_with_copy(self, error_msg):
        try:
            context = _get_context()
            if not context:
                return
            
            builder = AlertDialogBuilder(context)
            builder.set_title(self._t('error_occurred'))
            builder.set_message(error_msg)
            builder.set_positive_button(self._t('copy_error'), lambda d, w: copy_to_clipboard(error_msg))
            builder.set_negative_button(self._t('close'), lambda d, w: d.dismiss())
            builder.show()
        except Exception:
            pass
    
    def _check_version_compatibility(self, desktop_support):
        try:
            desktop_ver = int(desktop_support.strip())
        except ValueError:
            return 'ok'

        plugin_versions = [v.strip() for v in DESKTOP.split(',')]
        parsed = []
        for v in plugin_versions:
            try:
                parsed.append(int(v))
            except ValueError:
                continue

        if not parsed:
            return 'ok'

        for pv in parsed:
            if pv == desktop_ver:
                return 'ok'

        if all(pv < desktop_ver for pv in parsed):
            return 'update_plugin'
        elif all(pv > desktop_ver for pv in parsed):
            return 'update_desktop'
        else:
            return 'update_plugin'

    def _show_version_mismatch_dialog(self, title, message):
        try:
            frag = get_last_fragment()
            act = frag.getParentActivity() if frag else None
            if not act:
                return
            builder = AlertDialogBuilder(act)
            builder.set_title(title)
            builder.set_message(message)
            builder.set_positive_button(self._t('close'), lambda d, w: d.dismiss())
            builder.show()
        except Exception:
            pass

    def _handle_connection_request(self, device_name, os_name, address, token='', pc_address='', desktop_support=''):
        request_id = f"{token or device_name}_{os_name}_{int(time.time())}"
        self._connection_results[request_id] = None
        if not pc_address and address:
            pc_address = address[0]

        if not desktop_support:
            run_on_ui_thread(lambda: self._show_version_mismatch_dialog(
                self._t('desktop_outdated_title'), self._t('desktop_outdated_text')
            ))
            self._connection_results[request_id] = 'no'
            timeout = 60
            start_time = time.time()
            while time.time() - start_time < timeout:
                if self._connection_results[request_id] is not None:
                    result = self._connection_results[request_id]
                    del self._connection_results[request_id]
                    return result
                time.sleep(0.1)
            if request_id in self._connection_results:
                del self._connection_results[request_id]
            return 'no'

        compat_result = self._check_version_compatibility(desktop_support)
        if compat_result != 'ok':
            if compat_result == 'update_desktop':
                title = self._t('desktop_outdated_title')
                message = self._t('desktop_outdated_text')
            else:
                title = self._t('plugin_outdated_title')
                message = self._t('plugin_outdated_text')
            run_on_ui_thread(lambda: self._show_version_mismatch_dialog(title, message))
            self._connection_results[request_id] = 'no'
            timeout = 60
            start_time = time.time()
            while time.time() - start_time < timeout:
                if self._connection_results[request_id] is not None:
                    result = self._connection_results[request_id]
                    del self._connection_results[request_id]
                    return result
                time.sleep(0.1)
            if request_id in self._connection_results:
                del self._connection_results[request_id]
            return 'no'

        existing_device_index, existing_device = self._find_device_by_token(token)
        display_name = self._get_device_display_name(existing_device) if existing_device else device_name

        if existing_device and existing_device.get('blocked', False):
            if self.get_setting('notification_deny', False):
                run_on_ui_thread(lambda: BulletinHelper.show_success(self._t('notification_deny_text', name=display_name)))
            return f'no\nerror: device blocked'

        auto_approve = self.get_setting('auto_approve_connections', False)

        def auto_approve_connection():
            try:
                current_time = time.time()

                if existing_device_index >= 0:
                    device = self._saved_devices[existing_device_index]
                    device['last_connection'] = current_time
                    device['real_name'] = device_name
                    if pc_address:
                        device['url'] = pc_address
                    if token:
                        device['token'] = token
                else:
                    device_info = {
                        'serial': len(self._saved_devices) + 1,
                        'real_name': device_name,
                        'custom_name': device_name,
                        'url': pc_address or 'Unknown',
                        'token': token,
                        'first_connection': current_time,
                        'last_connection': current_time,
                        'os': os_name
                    }
                    self._saved_devices.append(device_info)

                self._persist_saved_devices()
                self._connection_results[request_id] = 'yes'
                if self.get_setting('notification_pair', False):
                    try:
                        BulletinHelper.show_success(self._t('notification_pair_text', name=display_name))
                    except Exception:
                        pass
            except Exception as e:
                self._connection_results[request_id] = 'no'

        if auto_approve and existing_device_index >= 0:
            run_on_ui_thread(auto_approve_connection)
        else:
            def show_dialog():
                try:
                    frag = get_last_fragment()
                    act = frag.getParentActivity() if frag else None
                    if not act:
                        return

                    builder = AlertDialogBuilder(act)
                    builder.set_title(self._t('connection_request'))
                    builder.set_message(self._t('connection_request_body', device=display_name, os=os_name))

                    def on_confirm(d, w):
                        current_time = time.time()

                        if existing_device_index >= 0:
                            device = self._saved_devices[existing_device_index]
                            device['last_connection'] = current_time
                            device['real_name'] = device_name
                            if pc_address:
                                device['url'] = pc_address
                            if token:
                                device['token'] = token
                        else:
                            device_info = {
                                'serial': len(self._saved_devices) + 1,
                                'real_name': device_name,
                                'custom_name': device_name,
                                'url': pc_address or 'Unknown',
                                'token': token,
                                'first_connection': current_time,
                                'last_connection': current_time,
                                'os': os_name
                            }
                            self._saved_devices.append(device_info)

                        self._persist_saved_devices()
                        self._connection_results[request_id] = 'yes'
                        if self.get_setting('notification_pair', False):
                            try:
                                BulletinHelper.show_success(self._t('notification_pair_text', name=display_name))
                            except Exception:
                                pass
                        d.dismiss()

                    def on_reject(d, w):
                        self._connection_results[request_id] = f'no\nerror: {self._t("request_rejected")}'
                        d.dismiss()

                    builder.set_positive_button(self._t('confirm'), on_confirm)
                    builder.set_negative_button(self._t('reject'), on_reject)
                    builder.show()
                except Exception:
                    self._connection_results[request_id] = 'no'

            run_on_ui_thread(show_dialog)
        
        timeout = 60
        start_time = time.time()
        while time.time() - start_time < timeout:
            if self._connection_results[request_id] is not None:
                result = self._connection_results[request_id]
                del self._connection_results[request_id]
                return result
            time.sleep(0.1)
        
        if request_id in self._connection_results:
            del self._connection_results[request_id]
        return 'no'
    
    def _handle_install_request(self, filename, file_data, token=''):
        idx, device = self._find_device_by_token(token)
        if idx < 0:
            return f'no\nerror: {self._t("device_not_connected")}'
        if device and device.get('blocked', False):
            return f'no\nerror: {self._t("device_not_connected")}'

        self._saved_devices[idx]['last_connection'] = time.time()
        self._persist_saved_devices()
        auto_install = self.get_setting('auto_install_plugins', False)
        result_container = [None]

        def _get_elyx_exts():
            raw = self.get_setting('elyx_extensions', None)
            if raw is None or (isinstance(raw, str) and not raw.strip()):
                exts = ELYX
            else:
                if isinstance(raw, list):
                    parts = raw
                else:
                    parts = re.split(r'[,\s;]+', str(raw))
                exts = []
                for p in parts:
                    p = p.strip().lower()
                    if not p:
                        continue
                    if not p.startswith('.'):
                        p = '.' + p
                    exts.append(p)
                if not exts:
                    exts = ELYX
            return set(exts)

        orig_ext = os.path.splitext(filename)[1].lower() if filename else ''
        is_elyx = orig_ext in _get_elyx_exts()
        temp_ext = orig_ext if orig_ext else ('.eaf' if is_elyx else '.plugin')

        def _write_temp_file():
            cache_dir = get_cache_dir()
            temp_file = os.path.join(str(cache_dir), f"install_{int(time.time())}{temp_ext}")
            with open(temp_file, 'wb') as f:
                f.write(file_data)
            return temp_file

        def _notify_success(name):
            if ADBLiteServer.plugin_instance and ADBLiteServer.plugin_instance.get_setting('notification_install', False):
                run_on_ui_thread(lambda: BulletinHelper.show_success(
                    ADBLiteServer.plugin_instance._t('notification_install_text', name=name)
                ))

        if auto_install:
            if is_elyx:
                try:
                    from zipfile import ZipFile
                    try:
                        from elyxcore._plugin import ElyxPlugin
                        from elyxcore._plugin_engine import ElyxEngine
                    except ImportError:
                        from elyxcore import ElyxPlugin, ElyxEngine

                    temp_file = _write_temp_file()
                    elyx_plugin = ElyxPlugin(plzip=ZipFile(temp_file, "r"), raise_errors=False)

                    def _elyx_complete():
                        result_container[0] = 'yes'
                        _notify_success(filename)

                    def _elyx_error(error):
                        result_container[0] = f'no\nerror: {error}'

                    ElyxEngine.instance.load_from_archive(elyx_plugin, True, _elyx_complete, _elyx_error)
                except Exception as e:
                    result_container[0] = f'no\nerror: {str(e)}'
            else:
                try:
                    temp_file = _write_temp_file()
                    engine = PluginsController.getPluginEngine(JFile(temp_file))
                    if engine:
                        validation_result = engine.validatePluginFromFile(temp_file)
                        plugin_meta = validation_result.getPlugin()
                        if plugin_meta:
                            class _IC(dynamic_proxy(Utilities.Callback)):
                                def __init__(self, c, fname):
                                    super().__init__()
                                    self._c = c
                                    self._fname = fname
                                def run(self, result):
                                    if result is None or (isinstance(result, str) and len(result) == 0):
                                        self._c[0] = 'yes'
                                        _notify_success(self._fname)
                                    else:
                                        self._c[0] = f'no\nerror: {result}'
                            engine.loadPluginFromFile(temp_file, plugin_meta, _IC(result_container, filename))
                        else:
                            result_container[0] = f'no\nerror: {validation_result.getError() or "Invalid plugin file"}'
                    else:
                        result_container[0] = 'no\nerror: Plugin engine not found'
                except Exception as e:
                    result_container[0] = f'no\nerror: {str(e)}'

            timeout = 300
            start_time = time.time()
            while time.time() - start_time < timeout:
                if result_container[0] is not None:
                    return result_container[0]
                time.sleep(0.1)
            return f'no\nerror: timeout'

        def show_install_dialog():
            try:
                fragment = get_last_fragment()
                if not fragment:
                    result_container[0] = f'no\nerror: {self._t("unknown_error")}'
                    return

                try:
                    temp_file = _write_temp_file()
                except Exception as e:
                    result_container[0] = f'no\nerror: {str(e)}'
                    return

                try:
                    abs_path = JFile(temp_file).getAbsolutePath()
                    if is_elyx:
                        eng = None
                        try:
                            eng = PluginsController.getPluginEngine(JFile(temp_file))
                        except Exception:
                            eng = None
                        if eng is not None:
                            PluginsController.getInstance().showInstallDialog(fragment, abs_path, True)
                        else:
                            try:
                                from elyxcore._plugin_engine import ElyxEngine
                            except ImportError:
                                from elyxcore import ElyxEngine
                            from com.exteragram.messenger.plugins.ui.components import InstallPluginBottomSheet
                            params = InstallPluginBottomSheet.PluginInstallParams(abs_path, False)
                            ElyxEngine.instance.showInstallDialog(fragment, params)
                    else:
                        PluginsController.getInstance().showInstallDialog(fragment, abs_path, True)
                    result_container[0] = 'yes'
                except Exception as e:
                    error_str = str(e)
                    run_on_ui_thread(lambda: self._show_error_with_copy(error_str))
                    result_container[0] = f'no\nerror: {error_str}'
                    if temp_file and os.path.exists(temp_file):
                        try:
                            os.remove(temp_file)
                        except:
                            pass
            except Exception as e:
                result_container[0] = f'no\nerror: {str(e)}'

        run_on_ui_thread(show_install_dialog)

        timeout = 300
        start_time = time.time()
        while time.time() - start_time < timeout:
            if result_container[0] is not None:
                return result_container[0]

        return f'no\nerror: timeout'
    
    def _toggle_server_async(self, enable):
        def toggle():
            if enable:
                success = self.start_server()
                if success:
                    self._register_nsd_service()
                    run_on_ui_thread(lambda: (
                        self.set_setting('enabled', True, reload_settings=True),
                        self._update_toggle_button(True)
                    ))
                else:
                    run_on_ui_thread(lambda: (
                        self.set_setting('enabled', False, reload_settings=True),
                        self._update_toggle_button(False),
                        BulletinHelper.show_error(self._t('all_ports_busy'))
                    ))
            else:
                self._unregister_nsd_service()
                self.stop_server()
                run_on_ui_thread(lambda: (
                    self.set_setting('enabled', False, reload_settings=True),
                    self._update_toggle_button(False)
                ))
        
        threading.Thread(target=toggle, daemon=True).start()
    
    def _on_enable_change(self, value):
        self.set_setting('enabled', value, reload_settings=False)
        self._toggle_server_async(value)
    
    def _copy_address(self, address):
        try:
            if isinstance(address, str):
                addr = address
            else:
                if self.get_setting('enabled', False) and self._server_port:
                    ip = self._get_local_ip()
                    addr = f"{ip}:{self._server_port}"
                else:
                    return
            
            fragment = get_last_fragment()
            if not fragment:
                return
            context = fragment.getParentActivity()
            if not context:
                return
            clipboard = context.getSystemService(context.CLIPBOARD_SERVICE)
            clipboard.setPrimaryClip(ClipData.newPlainText("link", str(addr)))
            try:
                icon_attr = getattr(R_tg.raw, 'copy', None)
                BulletinHelper.show_with_button(
                    self._t('copied_to_clipboard'),
                    icon_attr if icon_attr else 0,
                    self._t('close'),
                    lambda: None,
                    None
                )
            except Exception:
                pass
        except Exception as e:
            pass

