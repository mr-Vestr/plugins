        def on_support(v):
            try:
                sheet.dismiss()
                if not hasattr(LaunchActivity, 'instance') or LaunchActivity.instance is None:
                    return
                launch_activity = LaunchActivity.instance
                m = launch_activity.getClass().getDeclaredMethod("getSafeLastFragment")
                m.setAccessible(True)
                last_fragment = m.invoke(launch_activity)
                if last_fragment is None or last_fragment.getContext() is None:
                    return
                gift_sheet = GiftSheet(last_fragment.getContext(), UserConfig.selectedAccount, 2037728749, None, None)
                gift_sheet.show()
            except Exception:
                pass

        support_btn_frame.setOnClickListener(OnClickListener(lambda *_: on_support(support_btn_frame)))
        self._apply_press_scale(support_btn_frame)
        root_layout.addView(support_btn_frame, LayoutHelper.createLinear(-1, -2, 0, 8, 0, 0))

        sheet.setCustomView(root_layout)
        sheet.setCanDismissWithSwipe(False)
        sheet.show()

        def animate_elements():
            try:
                root_layout.animate().alpha(0.8).scaleX(0.4).scaleY(0.4).translationY(AndroidUtilities.dp(50)).setDuration(200).start()
                def scale_up():
                    root_layout.animate().alpha(1.0).scaleX(1.0).scaleY(1.0).translationY(0).setDuration(400).start()
                    def show_els():
                        try: title_view.animate().alpha(1.0).translationY(0).scaleX(1.0).scaleY(1.0).setDuration(350).start()
                        except Exception: pass
                        try: body_scroll.animate().alpha(1.0).translationY(0).scaleX(1.0).scaleY(1.0).setDuration(350).setStartDelay(50).start()
                        except Exception: pass
                        try: support_btn_frame.animate().alpha(1.0).translationY(0).scaleX(1.0).scaleY(1.0).setDuration(350).setStartDelay(100).start()
                        except Exception: pass
                    try: run_on_ui_thread(show_els)
                    except Exception: pass
                try: run_on_ui_thread(scale_up)
                except Exception: pass
            except Exception:
                pass
        try:
            run_on_ui_thread(animate_elements)
        except Exception:
            pass


    def _create_settings_header(self, context):
        try:
            from org.telegram.ui.Components.Premium import StarParticlesView
            container = FrameLayout(context)
            if self.get_setting('particles_in_settings', True):
                try:
                    particlesView = StarParticlesView(context)
                    particlesView.doNotFling = True
                    particlesView.setClipWithGradient()
                    particlesView.drawable.colorKey = Theme.key_premiumGradient1
                    particlesView.drawable.isCircle = True
                    particlesView.drawable.roundEffect = True
                    particlesView.drawable.useRotate = False
                    particlesView.drawable.useBlur = True
                    particlesView.drawable.checkBounds = True
                    particlesView.drawable.useScale = True
                    particlesView.drawable.startFromCenter = True
                    particlesView.drawable.centerOffsetY = AndroidUtilities.dp(24)
                    particlesView.drawable.size1 = 17
                    particlesView.drawable.size2 = 18
                    particlesView.drawable.size3 = 19
                    particlesView.drawable.init()
                    container.addView(particlesView, LayoutHelper.createFrame(-1, 238, Gravity.CENTER_HORIZONTAL | Gravity.TOP, 0, -10, 0, 0))
                except Exception:
                    pass

            main_layout = LinearLayout(context)
            main_layout.setOrientation(LinearLayout.VERTICAL)
            main_layout.setGravity(Gravity.CENTER)
            main_layout.setPadding(
                AndroidUtilities.dp(20), AndroidUtilities.dp(20),
                AndroidUtilities.dp(20), AndroidUtilities.dp(20)
            )
            imageView = BackupImageView(context)
            imageView.setRoundRadius(AndroidUtilities.dp(45))
            if not self.try_load_sticker(imageView, __icon__, 13, "130_130"):
                self.load_sticker_with_fallback(imageView, __icon__, 13, "130_130")
            sticker_container = FrameLayout(context)
            border_drawable = GradientDrawable()
            border_drawable.setShape(GradientDrawable.RECTANGLE)
            border_drawable.setCornerRadius(AndroidUtilities.dp(47))
            border_drawable.setColor(Color.WHITE)
            border_drawable.setStroke(AndroidUtilities.dp(3), Color.WHITE)
            sticker_container.setBackground(border_drawable)
            sticker_container.addView(imageView, LayoutHelper.createFrame(130, 130, Gravity.CENTER))
            main_layout.addView(sticker_container, LayoutHelper.createLinear(136, 136, Gravity.CENTER, 0, 0, 0, 16))
            text_container = LinearLayout(context)
            text_container.setOrientation(LinearLayout.VERTICAL)
            text_container.setGravity(Gravity.CENTER)
            title_view = TextView(context)
            title_view.setTextColor(Theme.getColor(Theme.key_windowBackgroundWhiteBlackText))
            title_view.setTypeface(AndroidUtilities.getTypeface(AndroidUtilities.TYPEFACE_ROBOTO_MEDIUM))
            title_view.setTextSize(TypedValue.COMPLEX_UNIT_DIP, 22)
            title_view.setText(f"{__name__} — {__version__}")
            title_view.setSingleLine(True)
            title_view.setGravity(Gravity.CENTER)
            text_container.addView(title_view, LayoutHelper.createLinear(-1, -2, 0, 0, 4, 0))
            subtitle_view = TextView(context)
            subtitle_view.setTextColor(Theme.getColor(Theme.key_windowBackgroundWhiteGrayText))
            subtitle_view.setTextSize(TypedValue.COMPLEX_UNIT_DIP, 14)
            subtitle_view.setText(self._t('description'))
            subtitle_view.setGravity(Gravity.CENTER)
            text_container.addView(subtitle_view, LayoutHelper.createLinear(-1, -2))
            main_layout.addView(text_container, LayoutHelper.createLinear(-1, -2, Gravity.CENTER))
            container.addView(main_layout, LayoutHelper.createFrame(-1, -2, Gravity.CENTER))
            return container
        except Exception:
            return None


    def _create_toggle_button_view(self, context):
        try:
            dp = AndroidUtilities.dp
            container = LinearLayout(context)
            container.setOrientation(LinearLayout.VERTICAL)
            container.setGravity(Gravity.CENTER)
            container.setPadding(dp(12), dp(16), dp(12), dp(12))
            is_enabled = self.get_setting('enabled', False)
            accent_color = Theme.getColor(Theme.key_featuredStickers_addButton)
            bg_color = Theme.getColor(Theme.key_windowBackgroundWhite)
            button_wrapper = FrameLayout(context)
            button_size = 144
            particles_view = None
            if is_enabled:
                try:
                    from org.telegram.ui.Components.Premium import StarParticlesView
                    particles_view = StarParticlesView(context, 160)
                    particles_view.setClipWithGradient()
                    particles_view.drawable.colorKey = Theme.key_featuredStickers_addButton
                    particles_view.drawable.isCircle = True
                    particles_view.drawable.roundEffect = True
                    particles_view.drawable.useRotate = False
                    particles_view.drawable.useBlur = True
                    particles_view.drawable.useScale = True
                    particles_view.drawable.startFromCenter = True
                    particles_view.drawable.centerOffsetY = 0
                    particles_view.drawable.speedScale = 1.5
                    particles_view.drawable.size1 = 24
                    particles_view.drawable.size2 = 36
                    particles_view.drawable.size3 = 48
                    particles_view.drawable.init()
                    button_wrapper.addView(particles_view, LayoutHelper.createFrame(-1, 180, Gravity.CENTER))
                    try:
                        particles_view.flingParticles(360)
                    except Exception:
                        pass
                except Exception:
                    pass

            button_container = FrameLayout(context)
            button_bg = GradientDrawable()
            button_bg.setShape(GradientDrawable.OVAL)
            button_bg.setColor(accent_color if not is_enabled else Color.WHITE)
            button_bg.setStroke(dp(2), Color.TRANSPARENT if not is_enabled else accent_color)
            button_container.setBackground(button_bg)
            icon_view = ImageView(context)
            if is_enabled:
                res_id = context.getResources().getIdentifier("msg_block_remix", "drawable", context.getPackageName())
                if res_id != 0:
                    icon_view.setImageResource(res_id)
                else:
                    icon_view.setImageResource(R.drawable.msg_block)
                icon_view.setColorFilter(accent_color, PorterDuff.Mode.SRC_IN)
            else:
                res_id = context.getResources().getIdentifier("msg_played_solar", "drawable", context.getPackageName())
                if res_id != 0:
                    icon_view.setImageResource(res_id)
                else:
                    icon_view.setImageResource(R.drawable.msg_played)
                icon_view.setColorFilter(Color.WHITE, PorterDuff.Mode.SRC_IN)
            button_container.addView(icon_view, LayoutHelper.createFrame(button_size, button_size, Gravity.CENTER))
            button_container.setClickable(True)
            button_container.setFocusable(True)
            button_wrapper.addView(button_container, LayoutHelper.createFrame(button_size, button_size, Gravity.CENTER))
            self._toggle_button_bg = button_bg
            self._toggle_icon_view = icon_view
            self._toggle_accent_color = accent_color
            self._toggle_status_text = None
            self._toggle_particles_view = particles_view
            self._toggle_button_wrapper = button_wrapper

            def on_button_click(v):
                current_state = self.get_setting('enabled', False)
                new_state = not current_state
                self._on_enable_change(new_state)
                self._update_toggle_button(new_state)
                if new_state:
                    if _is_first_launch():
                        _mark_first_launch()
                        run_on_ui_thread(lambda: self._show_setup_guide(None))

            button_container.setOnClickListener(OnClickListener(on_button_click))
            self._apply_press_scale(button_container)
            container.addView(button_wrapper, LayoutHelper.createLinear(-1, 180, Gravity.CENTER, 0, 0, 0, 8))
            status_text = TextView(context)
            status_text.setTextSize(TypedValue.COMPLEX_UNIT_DIP, 28)
            status_text.setGravity(Gravity.CENTER)
            status_text.setTextColor(accent_color if is_enabled else Color.WHITE)
            try:
                status_text.setTypeface(AndroidUtilities.getTypeface(AndroidUtilities.TYPEFACE_ROBOTO_MEDIUM))
            except Exception:
                pass
            
            if is_enabled:
                status_text.setText(self._t('enabled'))
            else:
                status_text.setText(self._t('disabled'))
            
            container.addView(status_text, LayoutHelper.createLinear(-2, -2, Gravity.CENTER))
            self._toggle_status_text = status_text

            return container
        except Exception as e:
            return None

    def _update_toggle_button(self, is_enabled):
        try:
            if hasattr(self, '_toggle_button_bg') and self._toggle_button_bg:
                accent = self._toggle_accent_color
                self._toggle_button_bg.setColor(accent if not is_enabled else Color.WHITE)
                self._toggle_button_bg.setStroke(AndroidUtilities.dp(2), Color.TRANSPARENT if not is_enabled else accent)
            
            if hasattr(self, '_toggle_icon_view') and self._toggle_icon_view:
                accent = self._toggle_accent_color
                if is_enabled:
                    try:
                        frag = get_last_fragment()
                        ctx = frag.getParentActivity() if frag else None
                        if ctx:
                            res_id = ctx.getResources().getIdentifier("msg_block_remix", "drawable", ctx.getPackageName())
                            if res_id != 0:
                                self._toggle_icon_view.setImageResource(res_id)
                            else:
                                self._toggle_icon_view.setImageResource(R.drawable.msg_block)
                    except Exception:
                        self._toggle_icon_view.setImageResource(R.drawable.msg_block)
                    self._toggle_icon_view.setColorFilter(accent, PorterDuff.Mode.SRC_IN)
                else:
                    try:
                        frag = get_last_fragment()
                        ctx = frag.getParentActivity() if frag else None
                        if ctx:
                            res_id = ctx.getResources().getIdentifier("msg_played_solar", "drawable", ctx.getPackageName())
                            if res_id != 0:
                                self._toggle_icon_view.setImageResource(res_id)
                            else:
                                self._toggle_icon_view.setImageResource(R.drawable.msg_played)
                    except Exception:
                        self._toggle_icon_view.setImageResource(R.drawable.msg_played)
                    self._toggle_icon_view.setColorFilter(Color.WHITE, PorterDuff.Mode.SRC_IN)
            
            if hasattr(self, '_toggle_button_wrapper') and self._toggle_button_wrapper:
                if is_enabled and not hasattr(self, '_toggle_particles_view'):
                    try:
                        from org.telegram.ui.Components.Premium import StarParticlesView
                        frag = get_last_fragment()
                        ctx = frag.getParentActivity() if frag else None
                        if ctx:
                            particles_view = StarParticlesView(ctx, 160)
                            particles_view.setClipWithGradient()
                            particles_view.drawable.colorKey = Theme.key_featuredStickers_addButton
                            particles_view.drawable.isCircle = True
                            particles_view.drawable.roundEffect = True
                            particles_view.drawable.useRotate = False
                            particles_view.drawable.useBlur = True
                            particles_view.drawable.useScale = True
                            particles_view.drawable.startFromCenter = True
                            particles_view.drawable.centerOffsetY = 0
                            particles_view.drawable.speedScale = 1.5
                            particles_view.drawable.size1 = 24
                            particles_view.drawable.size2 = 36
                            particles_view.drawable.size3 = 48
                            particles_view.drawable.init()
                            self._toggle_button_wrapper.addView(particles_view, 0, LayoutHelper.createFrame(-1, 180, Gravity.CENTER))
                            self._toggle_particles_view = particles_view
                            try:
                                particles_view.flingParticles(360)
                            except Exception:
                                pass
                    except Exception:
                        pass
                elif not is_enabled and hasattr(self, '_toggle_particles_view') and self._toggle_particles_view:
                    try:
                        self._toggle_button_wrapper.removeView(self._toggle_particles_view)
                        delattr(self, '_toggle_particles_view')
                    except Exception:
                        pass
            
            if hasattr(self, '_toggle_status_text') and self._toggle_status_text:
                accent = self._toggle_accent_color
                if is_enabled:
                    self._toggle_status_text.setText(self._t('enabled'))
                    self._toggle_status_text.setTextColor(accent)
                else:
                    self._toggle_status_text.setText(self._t('disabled'))
                    self._toggle_status_text.setTextColor(Color.WHITE)
        except Exception as e:
            pass

    def create_manage_adb_lite_submenu(self):
        try:
            frag = get_last_fragment()
            ctx = frag.getParentActivity() if frag else None
            if ctx:
                toggle_view = self._create_toggle_button_view(ctx)
                if toggle_view:
                    is_enabled = self.get_setting('enabled', False)
                    if is_enabled and self._server_port:
                        ip = self._get_local_ip()
                        address = f"{ip}:{self._server_port}"
                        device_info = self._get_device_info()
                        app_name = device_info.get('app', 'Unknown')
                        device_name = device_info.get('device', 'Unknown')

                        items = [
                            Custom(view=toggle_view),
                            Divider(),
                            Text(
                                text=self._t('setup_guide'),
                                icon='msg_psa',
                                on_click=self._show_setup_guide,
                            ),
                            Divider(),
                            Header(text=self._t('info_section')),
                            Text(
                                text=self._t('device_address'),
                                subtext=address,
                                icon="msg_limit_links",
                                on_click=lambda addr=address: self._copy_address(addr)
                            ),
                            Text(
                                text=self._t('client_name'),
                                subtext=app_name,
                                icon="extera_outline_remix",
                                on_click=lambda ctx: self._copy_client_name()
                            ),
                            Text(
                                text=self._t('device_name'),
                                subtext=device_name,
                                icon="menu_username_remix",
                                on_click=lambda ctx: self._copy_device_name()
                            ),
                        ]

                        connected = self._get_currently_connected()
                        if connected:
                            items.append(Divider())
                            items.append(Header(text=self._t('current_connection_section')))
                            for dev in connected:
                                tkn = dev['token']
                                items.append(Text(
                                    text=dev['display_name'],
                                    subtext=f"{dev['os']} • {dev['address']}",
                                    icon="msg_select",
                                    on_click=(lambda t: lambda *a: self._on_connected_device_click(t))(tkn),
                                ))

                        return items
                    else:
                        default_device_name = self.get_setting('default_device_name', '')
                        if not default_device_name:
                            try:
                                device_info = self._get_device_info()
                                default_device_name = device_info.get('device', 'Unknown')
                            except Exception:
                                default_device_name = 'Unknown'
                        
                        default_port_range = self.get_setting('port_range', f'{MIN_PORT}-{MAX_PORT}')
                        
                        return [
                            Custom(view=toggle_view),
                            Divider(),
                            Input(
                                key='default_device_name',
                                text=self._t('default_device_name'),
                                subtext=self._t('default_device_name_sub'),
                                icon='menu_username_remix',
                                default=default_device_name,
                                on_change=lambda value: self.set_setting('default_device_name', value)
                            ),
                            Input(
                                key='port_range',
                                text=self._t('port_range'),
                                subtext=self._t('port_range_sub'),
                                icon='msg_limit_links',
                                default=default_port_range,
                                on_change=lambda value: self.set_setting('port_range', value)
                            ),
                        ]
        except Exception as e:
            pass

        return []

    def _get_os_animation_res(self, os_name):
        try:
            os_lower = os_name.lower().strip() if os_name else ''
            if 'windows' in os_lower or 'win' in os_lower:
                return getattr(R_tg.raw, 'windows_30', 0)
            elif 'mac' in os_lower or 'darwin' in os_lower:
                return getattr(R_tg.raw, 'mac_30', 0)
            elif 'linux' in os_lower:
                return getattr(R_tg.raw, 'linux_30', 0)
        except Exception:
            pass
        return 0

    def _create_device_card_view(self, context, device):
        try:
            dp = AndroidUtilities.dp
            accent_color = Theme.getColor(Theme.key_featuredStickers_addButton)
            bg_color = Theme.getColor(Theme.key_windowBackgroundWhite)
            card = LinearLayout(context)
            card.setOrientation(LinearLayout.VERTICAL)
            card.setPadding(dp(20), dp(20), dp(20), dp(20))
            try:
                card_bg = GradientDrawable()
                card_bg.setShape(GradientDrawable.RECTANGLE)
                card_bg.setCornerRadius(dp(14))
                card_bg.setColor(bg_color)
                card.setBackground(card_bg)
            except Exception:
                pass

            row = LinearLayout(context)
            row.setOrientation(LinearLayout.HORIZONTAL)
            row.setGravity(Gravity.CENTER_VERTICAL)

            circle_size = 72
            circle_container = FrameLayout(context)
            circle_bg = GradientDrawable()
            circle_bg.setShape(GradientDrawable.OVAL)
            circle_bg.setColor(accent_color)
            circle_container.setBackground(circle_bg)

            raw_res = self._get_os_animation_res(device.get('os', ''))
            if raw_res != 0:
                try:
                    anim_view = RLottieImageView(context)
                    colors = jarray(jint)([0, accent_color])
                    anim_view.setAnimation(raw_res, circle_size, circle_size, colors)
                    anim_view.setBackgroundColor(Color.TRANSPARENT)
                    anim_view.playAnimation()
                    circle_container.addView(anim_view, LayoutHelper.createFrame(circle_size, circle_size, Gravity.CENTER))
                except Exception:
                    fallback = ImageView(context)
                    fallback.setImageResource(getattr(R_tg.drawable, 'msg_block', 0))
                    fallback.setColorFilter(accent_color, PorterDuff.Mode.SRC_IN)
                    fallback.setPadding(dp(18), dp(18), dp(18), dp(18))
                    circle_container.addView(fallback, LayoutHelper.createFrame(circle_size, circle_size, Gravity.CENTER))
            else:
                fallback = ImageView(context)
                fallback.setImageResource(getattr(R_tg.drawable, 'msg_devices_solar', 0))
                fallback.setColorFilter(accent_color, PorterDuff.Mode.SRC_IN)
                fallback.setPadding(dp(18), dp(18), dp(18), dp(18))
                circle_container.addView(fallback, LayoutHelper.createFrame(circle_size, circle_size, Gravity.CENTER))

            row.addView(circle_container, LayoutHelper.createLinear(circle_size, circle_size, Gravity.CENTER_VERTICAL, 0, 0, dp(8), 0))
            text_column = LinearLayout(context)
            text_column.setOrientation(LinearLayout.VERTICAL)
            display_name = self._get_device_display_name(device)
            name_view = TextView(context)
            name_view.setText(display_name)
            name_view.setTextSize(TypedValue.COMPLEX_UNIT_DIP, 20)
            name_view.setTypeface(AndroidUtilities.bold())
            name_view.setTextColor(Theme.getColor(Theme.key_windowBackgroundWhiteBlackText))
            name_view.setSingleLine(True)
            name_view.setEllipsize(TextUtils.TruncateAt.END)
            text_column.addView(name_view, LayoutHelper.createLinear(-1, -2))
            os_name = device.get('os', '')
            os_row = LinearLayout(context)
            os_row.setOrientation(LinearLayout.HORIZONTAL)
            os_row.setGravity(Gravity.CENTER_VERTICAL)
            os_icon = ImageView(context)
            try:
                os_icon.setImageResource(getattr(R_tg.drawable, 'msg_devices_solar', 0))
            except Exception:
                pass
            os_icon.setScaleType(ImageView.ScaleType.CENTER_INSIDE)
            os_icon.setColorFilter(Theme.getColor(Theme.key_windowBackgroundWhiteGrayText), PorterDuff.Mode.SRC_IN)
            os_row.addView(os_icon, LayoutHelper.createLinear(16, 16, Gravity.CENTER_VERTICAL, 0, 0, dp(3), 0))
            os_view = TextView(context)
            os_view.setText(os_name if os_name else "")
            os_view.setTextSize(TypedValue.COMPLEX_UNIT_DIP, 14)
            os_view.setTextColor(Theme.getColor(Theme.key_windowBackgroundWhiteGrayText))
            os_view.setSingleLine(True)
            os_view.setEllipsize(TextUtils.TruncateAt.END)
            os_row.addView(os_view, LayoutHelper.createLinear(-1, -2))
            text_column.addView(os_row, LayoutHelper.createLinear(-1, -2, 0, dp(2), 0, 0))
            ip_text = device.get('url', 'Unknown')
            ip_row = LinearLayout(context)
            ip_row.setOrientation(LinearLayout.HORIZONTAL)
            ip_row.setGravity(Gravity.CENTER_VERTICAL)
            ip_icon = ImageView(context)
            try:
                ip_icon.setImageResource(getattr(R_tg.drawable, 'msg_limit_links', 0))
            except Exception:
                pass
            ip_icon.setScaleType(ImageView.ScaleType.CENTER_INSIDE)
            ip_icon.setColorFilter(Theme.getColor(Theme.key_windowBackgroundWhiteGrayText), PorterDuff.Mode.SRC_IN)
            ip_row.addView(ip_icon, LayoutHelper.createLinear(16, 16, Gravity.CENTER_VERTICAL, 0, 0, dp(3), 0))
            ip_view = TextView(context)
            ip_view.setText(ip_text)
            ip_view.setTextSize(TypedValue.COMPLEX_UNIT_DIP, 14)
            ip_view.setTextColor(Theme.getColor(Theme.key_windowBackgroundWhiteGrayText))
            ip_view.setSingleLine(True)
            ip_view.setEllipsize(TextUtils.TruncateAt.END)
            ip_row.addView(ip_view, LayoutHelper.createLinear(-1, -2))
            text_column.addView(ip_row, LayoutHelper.createLinear(-1, -2, 0, dp(0), 0, 0))
            row.addView(text_column, LayoutHelper.createLinear(0, -2, 1.0))
            card.addView(row, LayoutHelper.createLinear(-1, -2))

            return card
        except Exception as e:
            return None

    def create_saved_devices_submenu(self):
        self._saved_devices = self._load_saved_devices_from_storage()
        items = []
        dp = AndroidUtilities.dp
        
        if not self._saved_devices:
            items.append(Header(text=self._t('saved_devices')))
            items.append(Text(
                text=self._t('no_devices'),
                subtext=self._t('no_devices_desc')
            ))
            return items
        
        for idx, device in enumerate(self._saved_devices):
            try:
                items.append(Header(text=self._t('device_number', number=idx + 1)))
                frag = get_last_fragment()
                ctx = frag.getParentActivity() if frag else None
                if ctx:
                    card_view = self._create_device_card_view(ctx, device)
                    if card_view:
                        is_blocked = device.get('blocked', False)
                        items.append(Custom(view=card_view))
                        items.append(Text(
                            text=self._t('detailed_info'),
                            icon='msg_info',
                            accent=True,
                            on_click=lambda ctx2, d=device: self._show_device_info(ctx2, d)
                        ))
                        if is_blocked:
                            items.append(Text(
                                text=self._t('unblock_device'),
                                icon='msg_block',
                                accent=True,
                                on_click=lambda ctx2, i=idx: self._toggle_block_device(i)
                            ))
                        else:
                            items.append(Text(
                                text=self._t('block_device'),
                                icon='msg_block',
                                red=True,
                                on_click=lambda ctx2, i=idx: self._toggle_block_device(i)
                            ))
                        items.append(Text(
                            text=self._t('delete_device'),
                            icon="msg_delete_solar",
                            red=True,
                            on_click=lambda ctx2, i=idx: self._delete_device(i)
                        ))
                        if idx < len(self._saved_devices) - 1:
                            items.append(Divider())
            except Exception:
                pass
        
        return items

    def create_plugin_settings_submenu(self):
        _elyx_default = "\n".join(ELYX)
        _elyx_current = self.get_setting('elyx_extensions', _elyx_default)
        if isinstance(_elyx_current, list):
            _elyx_current = "\n".join(_elyx_current)
        return [
            Header(text=self._t('plugin_settings_section')),
            Switch(
                key='show_drawer_menu',
                text=self._t('main_plugins_menu_button'),
                subtext=self._t('main_plugins_menu_button_sub'),
                default=self.get_setting('show_drawer_menu', False),
                on_change=lambda value: (
                    self.set_setting('show_drawer_menu', value),
                    run_on_ui_thread(self._update_drawer_menu),
                    self._show_restart_bulletin()
                )[-1],
                link_alias='show_drawer_menu'
            ),
            Switch(
                key='show_settings_menu_button',
                text=self._t('settings_menu_button'),
                subtext=self._t('settings_menu_button_sub'),
                default=self.get_setting('show_settings_menu_button', True),
                on_change=lambda value: (
                    self.set_setting('show_settings_menu_button', value),
                    self._show_restart_bulletin()
                )[-1],
                link_alias='settings_menu_button'
            ),
            Divider(),
            Header(text=self._t('tools')),
            Switch(
                key='auto_approve_connections',
                text=self._t('auto_approve_connections'),
                subtext=self._t('auto_approve_connections_sub'),
                default=self.get_setting('auto_approve_connections', False),
                link_alias='auto_approve_connections'
            ),
            Switch(
                key='auto_install_plugins',
                text=self._t('auto_install_plugins'),
                subtext=self._t('auto_install_plugins_sub'),
                default=self.get_setting('auto_install_plugins', False),
                link_alias='auto_install_plugins'
            ),
            Input(
                key='elyx_extensions',
                text=self._t('elyx_extensions'),
                subtext=self._t('elyx_extensions_sub'),
                icon='msg_document',
                default=_elyx_current if _elyx_current else _elyx_default,
                on_change=lambda value: self.set_setting('elyx_extensions', value)
            ),
            Divider(),
            Header(text=self._t('notifications')),
            Switch(
                key='notification_pair',
                text=self._t('notification_pair'),
                subtext=self._t('notification_pair_sub'),
                icon='msg_share',
                default=False,
            ),
            Switch(
                key='notification_deny',
                text=self._t('notification_deny'),
                subtext=self._t('notification_deny_sub'),
                icon='msg_block',
                default=False,
            ),
            Switch(
                key='notification_disconnect',
                text=self._t('notification_disconnect'),
                subtext=self._t('notification_disconnect_sub'),
                icon='msg_remove',
                default=False,
            ),
            Switch(
                key='notification_install',
                text=self._t('notification_install'),
                subtext=self._t('notification_install_sub'),
                icon='msg_plugins',
                default=False,
            ),
            Divider(),
            Header(text=self._t('other')),
            Switch(
                key='particles_in_settings',
                text=self._t('particles_in_settings'),
                icon='menu_feature_premium',
                default=self.get_setting('particles_in_settings', True),
                link_alias='particles_in_settings'
            ),
            Selector(
                key='plugin_lang',
                text=self._t('plugin_language'),
                icon='msg_language',
                items=[self._t('system'), 'Русский', 'English'],
                default=self.get_setting('plugin_lang', 0),
                on_change=self._on_language_changed,
                link_alias='plugin_language'
            ),
        ]


    def create_settings(self):
        settings = []
        settings.append(Header(text=self._t('main')))
        settings.append(Text(
            text=self._t('manage_adb_lite'),
            icon='msg_language',
            accent=True,
            create_sub_fragment=self.create_manage_adb_lite_submenu,
            link_alias='manage_adb_lite_section'
        ))
        settings.append(Text(
            text=self._t('saved_devices'),
            icon='msg_devices_solar',
            create_sub_fragment=self.create_saved_devices_submenu,
            link_alias='saved_devices_section'
        ))
        settings.append(Text(
            text=self._t('plugin_settings_title'),
            icon='msg_settings',
            create_sub_fragment=self.create_plugin_settings_submenu,
            link_alias='plugin_settings_section'
        ))
        settings.append(Divider())
        settings.append(Header(text=self._t('contacts')))
        settings.append(Text(
            text=self._t('channel_1'),
            icon='msg_channel',
            on_click=self._open_channel_link,
            on_long_click=self._copy_channel_link
        ))
        settings.append(Text(
            text=self._t('personal_1'),
            icon='msg_contacts',
            on_click=lambda ctx: self._open_personal_link(ctx),
            on_long_click=self._copy_personal_link
        ))
        settings.append(Text(
            text=self._t('support_me'),
            icon='menu_feature_reactions',
            accent=True,
            on_click=self._show_support_me_menu,
            link_alias='support_me'
        ))
        settings.append(Divider())
        settings.append(Header(text=self._t('other')))
        settings.append(Text(
            text=self._t('how_it_works'),
            icon='msg_info',
            on_click=self._show_how_it_works,
            link_alias='how_it_works'
        ))
        settings.append(Text(
            text=self._t('plugin_version'),
            icon='msg_settings',
            accent=True,
            on_click=lambda ctx: self._show_version_dialog(ctx),
            link_alias='plugin_version'
        ))
        settings.append(Divider())
        return settings


plugin = ADBLitePlugin()
